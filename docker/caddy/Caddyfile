# One wildcard certificate (DNS-01 against the DigitalOcean zone). Every
# request goes to sish, which routes by hostname to whichever tunnel claimed it.
# TUNNEL_DOMAIN and DO_DNS_TOKEN come from the compose environment (.env).
*.{$TUNNEL_DOMAIN} {
	tls {
		dns digitalocean {env.DO_DNS_TOKEN}
	}
	@home host tunnel.{$TUNNEL_DOMAIN}
	respond @home "tunnel — see github.com/nadahlberg/tunnel" 200
	reverse_proxy sish:8080
}
